{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ferhat-patisserie",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Run the Worker for every request so security headers are applied to static pages too.
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "ferhat-talep" }
  ],
  "kv_namespaces": [
    { "binding": "STATE", "id": "c89bea22b3404d6ca2b6a32bbd4f3072" }
  ],
  "vars": {
    // Public, non-secret configuration. Secrets go in `wrangler secret put` / .dev.vars:
    //   AIRTABLE_TOKEN, RESEND_API_KEY
    "AIRTABLE_BASE": "appIECoE2FmwD8lbH",
    "AIRTABLE_TABLE": "Talepler",
    "AIRTABLE_TABLE_ID": "tbl3cxkReQkqrArlA",
    "MAIL_FROM": "Ferhat Patisserie via StriveForward <noreply@striveforward.io>",
    "OWNER_EMAIL": "1cihankoca@gmail.com",
    "MAIL_REPLY_TO": "",
    // Optional. Empty = photos served by this Worker at <origin>/foto/{id}/{n}.{ext} (R2 bucket stays private).
    "PHOTO_PUBLIC_BASE": "",
    "ALLOWED_ORIGINS": ""
  }
}
